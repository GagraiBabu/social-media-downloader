# Webshare Residential Proxy
# Keep real credentials only in Render Environment Variables.
WEBSHARE_PROXY_ENABLED=true
WEBSHARE_HOST=p.webshare.io
WEBSHARE_PORT=80
WEBSHARE_USERNAME=YOUR_WEBSHARE_USERNAME
WEBSHARE_PASSWORD=YOUR_WEBSHARE_PASSWORD
WEBSHARE_COUNTRY=
WEBSHARE_SESSION=
WEBSHARE_ROTATE=true

# App settings
# ALLOWED_ORIGINS=https://your-frontend.example.com
# MAX_FILE_SIZE_MB=100
# INFO_TIMEOUT_SECONDS=30
# DOWNLOAD_TIMEOUT_SECONDS=180
MAX_CONCURRENT_JOBS=1
YTDLP_RETRIES=3
YTDLP_FRAGMENT_RETRIES=3
YTDLP_SLEEP_REQUESTS=0
# Browser impersonation target for Facebook/Instagram extraction.
YTDLP_SOCIAL_IMPERSONATE=chrome
UVICORN_LIMIT_CONCURRENCY=16

# AI Backend Doctor
# These are non-secret test/behavior settings. Put API keys only in Render Environment Variables.
# AI_AGENT_TEST_URL=https://social-media-downloader-ai-dev.onrender.com
AI_TEST_VIDEO_URL=https://www.youtube.com/watch?v=BaW_jenozKc
AI_TEST_DOWNLOAD_QUALITY=1080p

# Platform-specific real-world diagnostics.
# Add more public URLs as needed, e.g. Instagram/TikTok/etc.
AI_PLATFORM_TEST_URLS={"facebook":"https://www.facebook.com/share/r/19e5GXfTpF/"}
AI_DOWNLOAD_TEST_PLATFORMS=facebook,instagram

AI_AGENT_DEEP_TESTS=true
AI_AGENT_MAX_REPAIR_ATTEMPTS=15
AI_AGENT_HEALTH_TIMEOUT_SECONDS=30
AI_AGENT_INFO_TEST_TIMEOUT_SECONDS=60
AI_AGENT_DOWNLOAD_TEST_TIMEOUT_SECONDS=240
AI_AGENT_DOWNLOAD_SAMPLE_BYTES=262144
AI_AGENT_DEPLOY_TIMEOUT_SECONDS=240
AI_AGENT_DEPLOY_POLL_SECONDS=8
AI_AGENT_TRIGGER_DEPLOY=true
