# Decodo Residential Proxy
# Get these values from Decodo Dashboard -> Residential -> Proxy setup.
# Keep real credentials only in Render Environment Variables.
DECODO_PROXY_ENABLED=true
DECODO_HOST=gate.decodo.com
DECODO_PORT=7000
DECODO_USERNAME=YOUR_DECODO_USERNAME
DECODO_PASSWORD=YOUR_DECODO_PASSWORD

# Optional: target a country (example: in for India, us for United States).
# Leave empty for the proxy location configured by your Decodo endpoint.
DECODO_COUNTRY=in

# Optional: sticky session identifier. Leave empty for rotating behavior.
# If your Decodo endpoint/port is configured for sticky sessions, set a stable ID.
DECODO_SESSION=

# App settings
# ALLOWED_ORIGINS=https://your-frontend.example.com
# MAX_FILE_SIZE_MB=100
# INFO_TIMEOUT_SECONDS=30
# DOWNLOAD_TIMEOUT_SECONDS=180
MAX_CONCURRENT_JOBS=1
YTDLP_RETRIES=3
YTDLP_FRAGMENT_RETRIES=3
UVICORN_LIMIT_CONCURRENCY=16
