# Webshare Residential Proxy
# Store real credentials only in Render Environment Variables.
WEBSHARE_PROXY_ENABLED=true
WEBSHARE_HOST=p.webshare.io
WEBSHARE_PORT=80
WEBSHARE_USERNAME=YOUR_WEBSHARE_USERNAME
WEBSHARE_PASSWORD=YOUR_WEBSHARE_PASSWORD

# Optional country targeting. Example: in
# Leave empty to use your Webshare plan's default location.
WEBSHARE_COUNTRY=

# Optional sticky session identifier.
# Leave empty when using rotating residential IPs.
WEBSHARE_SESSION=

# true = rotate IPs per request; false = do not append -rotate.
WEBSHARE_ROTATE=true

# App settings
# ALLOWED_ORIGINS=https://your-frontend.example.com
# MAX_FILE_SIZE_MB=100
# INFO_TIMEOUT_SECONDS=30
# DOWNLOAD_TIMEOUT_SECONDS=180
MAX_CONCURRENT_JOBS=1
YTDLP_RETRIES=2
YTDLP_FRAGMENT_RETRIES=1
# false = Webshare for extraction, direct media transfer first; auto-fallback to proxy if needed.
WEBSHARE_PROXY_MEDIA=false
YTDLP_SLEEP_REQUESTS=0
UVICORN_LIMIT_CONCURRENCY=16
